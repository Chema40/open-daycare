{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash":"allow"
  },
  "references": {
      "db-schema": {
        "path": "../07-DB-Schema",
        "description": "Schema de base de datos, tablas, columnas y referencias a crear, esto no está implementado en la base de datos, solo es para referencia"
      }
  }
}

